# AI PRO Janete. O instalador troca __DOMINIO__ pelo seu domínio; o certbot acrescenta o HTTPS.
map $http_upgrade $janete_conexao { default upgrade; "" close; }

server {
    listen 80;
    listen [::]:80;
    server_name __DOMINIO__;

    client_max_body_size 50m;

    # Supabase (login, banco, arquivos e tempo real)
    location ~ ^/(auth|rest|storage|realtime)/v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $janete_conexao;
        proxy_read_timeout 300s;
    }

    # App
    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $janete_conexao;
        proxy_read_timeout 120s;
    }
}
